# API
PORT=3000
DATABASE_URL=postgres://ctws:ctws@localhost:5432/ctws

# 认证
SESSION_TTL_DAYS=30
AUTH_REGISTRATION=closed          # open | invite | closed
AUTH_INVITE_CODE=                 # 仅 AUTH_REGISTRATION=invite 时需要

# Cookie —— 部署拓扑决定这三个值，见 spec §10.2
COOKIE_SAMESITE=lax               # lax（前后端同站）| none（跨站）
COOKIE_SECURE=true                # 仅 localhost 的 http 开发环境可设 false
COOKIE_DOMAIN=                    # 留空 = 仅当前主机

# 请求边界，见 spec §10.3
CORS_ORIGINS=http://localhost:5173
