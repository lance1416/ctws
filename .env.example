# Postgres, read by docker-compose.yml. Change the password for anything beyond local dev, and
# keep DATABASE_URL below in sync with these three values.
POSTGRES_USER=ctws
POSTGRES_PASSWORD=ctws
POSTGRES_DB=ctws

# API
PORT=3000
# Inside docker compose the database host is "postgres", not "localhost"
# (compose overrides this value for the api container from the POSTGRES_* values).
DATABASE_URL=postgres://ctws:ctws@localhost:5432/ctws

# Auth
SESSION_TTL_DAYS=30
# open | invite | closed
AUTH_REGISTRATION=closed
# Only needed when AUTH_REGISTRATION=invite
AUTH_INVITE_CODE=

# Cookies: the deployment topology decides these three values, see spec section 10.2.
# lax (frontend and API same-site) | none (cross-site, requires COOKIE_SECURE=true)
# The e2e runs with none + true on purpose, see CONTRIBUTING.md.
COOKIE_SAMESITE=lax
# Only a plain-http localhost dev setup may set this to false
COOKIE_SECURE=true
# Leave empty to scope the cookie to the current host only
COOKIE_DOMAIN=

# Request boundary, see spec section 10.3
CORS_ORIGINS=http://localhost:5173

# Web app (Vite). Base URL of the API, including the /api/v1 prefix; the default matches PORT.
VITE_API_BASE=http://localhost:3000/api/v1
