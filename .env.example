# Postgres, read by docker-compose.yml. Change the password for anything beyond local dev, and
# keep DATABASE_URL below in sync with these three values.
POSTGRES_USER=ctws
POSTGRES_PASSWORD=ctws
POSTGRES_DB=ctws

# API
PORT=3000
# Inside docker compose the database host is "postgres", not "localhost"
# (compose overrides this value for the api container from the POSTGRES_* values).
DATABASE_URL=postgres://ctws:ctws@localhost:5432/ctws

# Auth
SESSION_TTL_DAYS=30
# open | invite | closed
AUTH_REGISTRATION=closed
# Only needed when AUTH_REGISTRATION=invite
AUTH_INVITE_CODE=
# Per-IP attempts per minute on register and login. Tunable because a deployment behind a tunnel
# or NAT sees many users as one IP, and the e2e suite registers many users from one IP.
AUTH_RATE_LIMIT_MAX=20

# The instance-wide ceiling on auth requests per minute: what bounds argon2 on this box when
# someone sprays addresses at it. Measured: a rejected sign-in costs ~13ms of CPU, so this holds
# a flood to roughly 13% of one core. The e2e stack raises it because the suite registers
# hundreds of users a minute; leave it alone in production.
AUTH_CEILING=600

# Cookies: the deployment topology decides these three values.
# lax (frontend and API same-origin, the default topology) | none (split cross-site deployment,
# requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# Only a plain-http localhost dev setup may set this to false
COOKIE_SECURE=true
# Leave empty to scope the cookie to the current host only
COOKIE_DOMAIN=

# Request boundary
# Comma-separated origins allowed to call the API cross-origin. Optional: empty (the default)
# allows none, which is right for the same-origin deployment. Only a split deployment needs it.
CORS_ORIGINS=

# Directory holding the built web app (apps/web/dist) for the API to serve, with an SPA
# fallback. Optional: unset or missing means API only. The Docker image sets it itself.
# WEB_DIST=apps/web/dist

# Web app (Vite). Leave unset: the app calls /api/v1 on its own origin (in development Vite
# proxies /api to the API). Set only for a split deployment, to the full API URL with /api/v1.
# VITE_API_BASE=https://api.example.com/api/v1
