{
  "name": "ctws",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "typecheck": "pnpm -r --no-bail exec tsc --noEmit",
