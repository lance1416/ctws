{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignore": ["tools/palette/**"],
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.mjs"],
      "ignoreBinaries": ["cwebp"],
      "ignoreDependencies": ["@playwright/test"]
    },
    "apps/api": {
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx,css}", "e2e/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    }
  }
}
